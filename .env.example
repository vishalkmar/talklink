# Copy to .env and fill in. Never commit .env. Variables are explained in docs/ENV.md.
NODE_ENV=development
PORT=4000
APP_NAME=TalkLink
LOG_LEVEL=

MONGO_URI=mongodb://127.0.0.1:27017/talklink?replicaSet=rs0&directConnection=true

# 32+ char random strings: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=TalkLink
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
DEV_OTP_BYPASS=false

TURN_HOST=
TURN_SECRET=
TURN_TTL=3600

# Calls (Phase 17)
CALL_MAX_DURATION_MIN=120
AURA_PER_MINUTE=1
PEER_LOST_GRACE_SEC=15
RING_TIMEOUT_SEC=30

# Gamification (Phase 32)
STREAK_MIN_SECONDS=60
STREAK_WEEK_BONUS_CREDITS=200
STREAK_SAVER_DAYS=7
AURA_PER_GOOD_RATING=2
# Phase 33: invite friends (both get the bonus), Contact Us
REFERRAL_BONUS_CREDITS=200
REFERRAL_MAX_PER_DAY=20
REFERRAL_WINDOW_DAYS=7
INVITE_URL=
FEEDBACK_TO_EMAIL=
SUPPORT_EMAIL=
ANDROID_PACKAGE=com.talklink.app

FIREBASE_SERVICE_ACCOUNT=
ADMOB_SSV_ENABLED=true
ADMOB_SSV_KEYS_URL=https://www.gstatic.com/admob/reward/verifier-keys.json
ADMOB_AD_UNIT_IDS=

CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2023-08-01
CASHFREE_RETURN_URL=
CASHFREE_NOTIFY_URL=

# Plans (Phase 31) - INR
PREMIUM_WEEKLY_PRICE=49
PREMIUM_MONTHLY_PRICE=149
PREMIUM_YEARLY_PRICE=999
CREDIT_PACKS=5000:49,12000:99,30000:199
PREMIUM_EXTRA_SPINS=3

GENDER_FILTER_COST=10000
GENDER_FILTER_PASS_MIN=30
AD_REWARD_CREDITS=500
DAILY_AD_LIMIT=20
SIGNUP_BONUS_CREDITS=100
DAILY_BONUS_CREDITS=20
SPINS_PER_DAY=5
FREE_SPINS_PER_DAY=1
REWARD_ABUSE_LIMIT=15
REWARDS_BLOCK_EMULATORS=true
MIN_APP_VERSION=1.0.0

# Protects /api/v1/admin/* (header X-Admin-Key). Empty = admin API disabled. 24+ chars.
ADMIN_API_KEY=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_DSN=
CORS_ORIGINS=
# proxy hops in front of the app in production (Render: 1)
TRUST_PROXY=1
# optional: DNS servers for lookups (local PC whose DNS refuses mongodb+srv SRV queries); empty = system
DNS_SERVERS=
# keep a free Render instance awake (production): pings <url>/health/ping every N minutes.
# Empty URL -> Render's RENDER_EXTERNAL_URL. KEEP_ALIVE_MINUTES=0 switches it off.
KEEP_ALIVE_URL=
KEEP_ALIVE_MINUTES=10
